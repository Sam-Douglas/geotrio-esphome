# Copy the lines you need into your ESPHome secrets.yaml (in Device Builder: the "Secrets" button
# at the top right). Never commit your real secrets.yaml.

wifi_ssid: "Your WiFi name"
wifi_password: "Your WiFi password"

# 32 random bytes, base64 encoded (44 characters ending in "="). Keep the key Device Builder
# generated when you created the device, or copy a fresh one from https://esphome.io/components/api/
geo_trio_api_key: "REPLACE_WITH_A_BASE64_KEY_44_CHARACTERS_LONG="

geo_trio_ota_password: "choose-a-long-random-password"
geo_trio_fallback_password: "choose-another-password"
